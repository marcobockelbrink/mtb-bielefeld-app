{
  "name": "mtb-bielefeld-app",
  "version": "0.9.0",
  "main": "expo-router/entry",
  "type": "module",
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/barlow-semi-condensed": "^0.4.1",
    "@expo/metro-runtime": "~57.0.10",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.13",
    "expo-background-task": "~57.0.10",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "EXPO_PUBLIC_API_URL=https://api-dev.bockelbrink.net expo start",
    "android": "expo run:android",
    "android:dev": "EXPO_PUBLIC_API_URL=https://api-dev.bockelbrink.net expo start --android",
    "ios": "expo run:ios",
    "ios:dev": "pkill -f \"expo start\" || true; EXPO_PUBLIC_API_URL=https://api-dev.bockelbrink.net expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "rauchprobe": "node --experimental-strip-types tools/rauchprobe.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vorschau": "expo export --platform web --output-dir .vorschau-web && node tools/serve-und-schiessen.mjs",
    "proxy": "node tools/dev-proxy.mjs",
    "vorbereiten:prod": "EXPO_PUBLIC_APP_UMGEBUNG=prod expo prebuild --clean"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}
