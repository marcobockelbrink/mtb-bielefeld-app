{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "dev-testflight": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app-dev.mtb-bielefeld.de"
      }
    },
    "prod": {
