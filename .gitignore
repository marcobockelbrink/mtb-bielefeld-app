# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Expo lädt `.env` im Wurzelverzeichnis von selbst und bettet jede
# EXPO_PUBLIC_-Variable ins Bündel ein. Eine solche Datei wäre damit ein
# stiller Umgebungsschalter für **jeden** Befehl — und im öffentlichen
# Repository ein Fund.
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# `/ios/*` statt `/ios`: Git kann nichts wieder einschließen, dessen
# Elternverzeichnis ausgeschlossen ist. Gebraucht wird die Ausnahme für
# `ios/ci_scripts/` — dort sucht Xcode Cloud seine Bauskripte, und der
# Ordner darüber wird bei jedem Bau neu erzeugt.
/ios/*
!/ios/ci_scripts/
/android

# Web-Vorschau für die Screenshots
.vorschau-web/

# Zwischenstand der Logo-Aufbereitung
.logo-arbeit/

# Arbeitsbereich der Umsetzungsabläufe (Zwischenstände, kein Quelltext)
.superpowers/

# Backend
api/node_modules/
api/dist/

# Zugangsdaten des Betriebsaufbaus — das Repository ist öffentlich.
betrieb/.env
docs/appstore-screenshots/

# Design-Handoffs: Referenz-Prototypen (HTML + fremde Laufzeit-JS), kein
# Projektcode. Sie gehoerten nie ins Repository — mit 4c67a8c versehentlich
# per `git add -A` hineingeraten und mit dem Folgecommit wieder entfernt.
# Die Entwurfspakete des Designs gehoeren nicht ins Repository: Sie sind
# Zulieferung, kein Projektbestand, und ihr mitgeliefertes `support.js`
# loeste zweimal CodeQL-Warnungen aus (postMessage ohne Origin-Pruefung).
# **Beide Muster noetig** — die neueren Ordner heissen `handoff_*` ohne
# das Praefix `design_`, und genau daran ist es beim zweiten Mal wieder
# vorbeigerutscht.
design_handoff_*/
handoff_*/
