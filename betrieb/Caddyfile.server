# Der Betriebsaufbau auf dem Server.
#
# **Wörtlich `betrieb/Caddyfile`, mit genau einer Änderung:** der Domainname
# statt `:80`. Damit holt Caddy das Zertifikat von Let's Encrypt selbst — er
# braucht dafür nur, dass die Domain schon auf diesen Server zeigt und Port
# 80 von außen erreichbar ist.
#
# Die Zonen darunter sind unverändert. Wer eine ändert, ändert sie in beiden
# Dateien; weichen sie ab, ist die hier laufende die Wahrheit und die lokale
# zieht nach — dieselbe Regel wie zwischen `api/caddy/anmeldung.Caddyfile`
# und `betrieb/Caddyfile`.
#
# **Kein `trusted_proxies`.** Ohne diese Zeile ersetzt Caddy ein
# mitgeschicktes `X-Forwarded-For` durch die echte Adresse, statt sie
# anzuhängen — und nur deshalb kann niemand der API von außen eine erfundene
# IP unterschieben. Wer sie einträgt, weil ein CDN davorkommt, muss
# `VERTRAUTER_PROXY` mit anpassen (`api/src/app.ts`), sonst ist die
# Begrenzung je IP wertlos, ohne dass ein Test rot wird.

api.mtb-bielefeld.de {
	rate_limit {
		zone anmeldung {
			match {
				path /anmeldung/* /sitzung* /konto* /gast/*
			}
			key {remote_host}
			events 10
			window 1m
		}

		zone tourenanmeldung {
			match {
				path /termine/*
				method POST DELETE
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	reverse_proxy api:3000
}
