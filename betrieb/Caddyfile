# Der Betriebsaufbau, lokal.
#
# Unterschiede zum Server, alle absichtlich und hier benannt:
#   - `:80` statt eines Domainnamens: Lokal gibt es kein DNS und kein
#     Let's-Encrypt-Zertifikat. Auf dem Server steht hier
#     `api.mtb-bielefeld.de`, und Caddy holt das Zertifikat von selbst.
#   - `reverse_proxy api:3000` statt `localhost:3000`: Im Compose-Netz
#     heißen die Dienste wie ihre Einträge.
# Alles andere — Zonen, Pfade, Kontingente — ist identisch mit dem, was
# später auf dem Server läuft. Genau deshalb ist dieser Aufbau mehr als
# eine Attrappe: Was hier greift, greift dort.
#
# Hier steht mit Absicht **kein** `trusted_proxies`. Ohne diese Zeile
# ersetzt Caddy ein mitgeschicktes `X-Forwarded-For` durch die echte
# Adresse des Anfragenden, statt sie anzuhängen — und nur deshalb kann
# niemand der API von außen eine erfundene IP unterschieben. Die API
# vertraut nämlich dem ganzen Docker-Bereich `172.16.0.0/12`
# (`VERTRAUTER_PROXY`, siehe `api/src/app.ts`), weil Compose die
# Container-Adressen dynamisch vergibt. Wer `trusted_proxies` einträgt —
# der naheliegende Handgriff, sobald ein CDN oder Lastverteiler davorsteht
# — muss `VERTRAUTER_PROXY` mit anpassen, sonst ist die Begrenzung je IP
# wertlos, ohne dass irgendein Test rot wird.

:80 {
	rate_limit {
		zone anmeldung {
			match {
				path /anmeldung/* /sitzung* /konto* /gast/*
			}
			key {remote_host}
			events 10
			window 1m
		}

		zone tourenanmeldung {
			match {
				path /termine/* /jugendtraining*
				method POST DELETE PATCH PUT
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	reverse_proxy api:3000
}
